<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /holly-sells-homes/

  # Don't rewrite if it's a real file or directory
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Rewrite /listing/* URLs to /listing/index.html
  RewriteRule ^listing/(.+)/?$ listing/index.html [L,QSA]
</IfModule>
